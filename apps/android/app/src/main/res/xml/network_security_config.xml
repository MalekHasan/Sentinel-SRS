<!-- No plain HTTP, and only the system's certificate authorities: the indicator feed is
     fetched over HTTPS and its signature checked on top (ADR-0019). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
