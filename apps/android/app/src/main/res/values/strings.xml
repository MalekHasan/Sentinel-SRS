    <!-- Each rule's title and one-sentence explanation (AL-02): plain words, reading grade 8 or lower. -->
    <string name="alert_monitoring_interrupted_title">Monitoring stopped</string>
    <string name="alert_monitoring_interrupted_text">Sentinel stopped watching your apps, so what they did in that time is not recorded.</string>
    <string name="alert_first_network_use_title">A new app used the internet</string>
    <string name="alert_first_network_use_text">This app was installed after Sentinel started, and Sentinel just saw it connect to the internet for the first time.</string>
    <string name="alert_first_network_use_blocked_title">A new app was blocked</string>
    <string name="alert_first_network_use_blocked_text">This app was installed after you chose to block new apps, so it cannot use the internet until you allow it.</string>
    <string name="alert_new_destination_title">An app connected to new places</string>
    <string name="alert_new_destination_text">This app connected to places it had not used before, which is often normal after an update.</string>
    <string name="alert_dns_servers_changed_title">DNS servers changed</string>
    <string name="alert_dns_servers_changed_text">The network you are on now looks up names at other servers, which could send your apps to the wrong places.</string>
    <string name="alert_private_dns_changed_title">Private DNS changed</string>
    <string name="alert_private_dns_changed_text">Your phone now asks a different service to look up names, and that service can see which sites you visit.</string>
    <string name="alert_proxy_changed_title">Proxy changed</string>
    <string name="alert_proxy_changed_text">Your web traffic may now pass through a different proxy, which can see or change what you send.</string>
    <string name="alert_known_indicator_title">Known traces of spyware found</string>
    <string name="alert_known_indicator_text">An app on this phone reached a server that public reports link to spyware or stalkerware.</string>
    <string name="alert_known_indicator_app_title">Known stalkerware or spyware app found</string>
    <string name="alert_known_indicator_app_text">An app on this phone is one that public reports name as stalkerware or spyware.</string>
    <string name="alert_known_indicator_past_title">Known traces of spyware found in past traffic</string>
    <string name="alert_known_indicator_past_text">A new list of known spyware servers matches connections this phone made before the list arrived.</string>
    <string name="alert_special_access_title">An app got special access to this phone</string>
    <string name="alert_special_access_text">Someone turned on access that lets this app watch what you do. Some apps need it to work.</string>
    <string name="alert_accessibility_title">An app can see your screen and act for you</string>
    <string name="alert_accessibility_text">This lets the app read what is on the screen and tap for you. Some apps need it. If you did not turn it on, someone else may have.</string>
    <string name="alert_device_admin_title">An app was made a device admin</string>
    <string name="alert_device_admin_text">A device admin app can lock or wipe the phone, and you cannot remove it until you turn this off. If you did not turn it on, someone else may have.</string>
    <string name="alert_notification_access_title">An app can read your notifications</string>
    <string name="alert_notification_access_text">This lets the app read every notification, with your messages and codes. If you did not turn it on, someone else may have.</string>
    <string name="alert_remote_access_exposed_title">Wireless debugging is on</string>
    <string name="alert_remote_access_exposed_text">A computer paired with this phone over Wi-Fi can install apps and read its data. If you do not use it, turn it off.</string>
    <string name="alert_new_root_certificate_title">A new trusted certificate was added</string>
    <string name="alert_new_root_certificate_text">With it, someone may be able to read your web traffic. Work or school phones may need one. If you did not add it, remove it.</string>

