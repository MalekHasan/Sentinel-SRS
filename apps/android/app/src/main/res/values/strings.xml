    <string name="feed_check">Check for a new list</string>
    <string name="feed_import">Import from a folder</string>
    <string name="feed_checking">Checking…</string>
    <string name="feed_explainer">Every few hours Sentinel looks for a new list where it is published on GitHub, and checks its signature before using it. The request carries nothing about you or this phone.</string>
    <!-- The result (MS-15): "Known traces found" or "No known traces found", with the list's date. Never "clean" or "safe". -->
    <string name="feed_result_found">Known traces found</string>
    <plurals name="feed_result_found_text">
        <item quantity="one">%1$d alert names known spyware or stalkerware. The list in use is from %2$s. Open the alert to see what was found and what to do.</item>
        <item quantity="other">%1$d alerts name known spyware or stalkerware. The list in use is from %2$s. Open the alerts to see what was found and what to do.</item>
    </plurals>
    <string name="feed_result_none">No known traces found</string>
    <string name="feed_result_none_text">Nothing in the traffic Sentinel kept since %1$s matches the list from %2$s.</string>
    <string name="feed_result_limits">This is not proof that the phone has no spyware. Sentinel finds only traces that have been published, in traffic it saw. Spyware that controls a phone can hide from every app on it.</string>
    <string name="feed_result_pending">The history has not been checked against this list yet.</string>
