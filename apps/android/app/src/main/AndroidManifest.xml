<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The engine opens the real (protected) connections for every app. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Follow the real network's resolvers for DNS forwarding. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The tunnel runs in a foreground service with a visible notification (SRS §15.3).
         systemExempted is the type Android 14+ allows for VPN apps (PLAY-POLICY.md). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Name the app behind each connection, and check installed apps against the
         stalkerware list (ID-13). Declared to Google Play as a device-security use
         (PLAY-POLICY.md, AM-14). -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- allowBackup=false: the local database holds sensitive history and must not
         leave the phone through cloud backups (SRS NF-11, §15.2). -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sentinel">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Not exported: only Android itself (which holds BIND_VPN_SERVICE) can bind
             it, and only this app can start or stop it (THREAT-MODEL-A E1).

             ForegroundServicePermission is suppressed because lint knows only half of
             the rule: Android accepts systemExempted with FOREGROUND_SERVICE_SYSTEM_EXEMPTED
             plus either an exact-alarm permission or the ACTIVATE_VPN app op, which the
             user grants in the VPN consent dialog. Lint cannot see app ops. Exact-alarm
             permissions are for alarm apps and must not be requested here.
             MonitoringTest starts this service on Android 14 to prove the type works. -->
        <service
            android:name=".SentinelVpnService"
            android:exported="false"
            android:foregroundServiceType="systemExempted"
            android:permission="android.permission.BIND_VPN_SERVICE"
            tools:ignore="ForegroundServicePermission">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>
</manifest>
