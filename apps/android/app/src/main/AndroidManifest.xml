<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The engine opens the real (protected) connections for every app. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Follow the real network's resolvers for DNS forwarding. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The tunnel runs in a foreground service with a visible notification (SRS §15.3).
         systemExempted is the type Android 14+ allows for VPN apps (PLAY-POLICY.md). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Name the app behind each connection, and check installed apps against the
         stalkerware list (ID-13). Declared to Google Play as a device-security use
         (PLAY-POLICY.md, AM-14). -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Whether Android Advanced Protection is on, for the hardening checklist (MS-12).
         Granted at install; Android 16 and later only. -->
    <uses-permission android:name="android.permission.QUERY_ADVANCED_PROTECTION_MODE" />
    <!-- Usage access, which only the user can grant in Android's settings: the app on
         screen, Sentinel's guess at which app uses the microphone or camera (SE-01 basic,
         AM-15, PLAY-POLICY.md). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- allowBackup=false: the local database holds sensitive history and must not
         leave the phone through cloud backups (SRS NF-11, §15.2). -->
    <!-- networkSecurityConfig: no plain HTTP; the indicator feed is fetched over HTTPS
         (ADR-0019). Debug builds also allow the device tests' local server. -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sentinel">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Not exported: only Android itself (which holds BIND_VPN_SERVICE) can bind
             it, and only this app can start or stop it (THREAT-MODEL-A E1).

             ForegroundServicePermission is suppressed because lint knows only half of
             the rule: Android accepts systemExempted with FOREGROUND_SERVICE_SYSTEM_EXEMPTED
             plus either an exact-alarm permission or the ACTIVATE_VPN app op, which the
             user grants in the VPN consent dialog. Lint cannot see app ops. Exact-alarm
             permissions are for alarm apps and must not be requested here.
             MonitoringTest starts this service on Android 14 to prove the type works. -->
        <service
            android:name=".SentinelVpnService"
            android:exported="false"
            android:foregroundServiceType="systemExempted"
            android:permission="android.permission.BIND_VPN_SERVICE"
            tools:ignore="ForegroundServicePermission">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Looks for a newer indicator list every few hours (MS-10). Only the system's
             job scheduler can bind it. -->
        <service
            android:name=".FeedUpdateJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
