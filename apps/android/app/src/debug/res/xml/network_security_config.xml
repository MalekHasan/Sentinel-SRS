<!-- Debug builds only: as the release configuration, and plain HTTP to this phone's own
     loopback address, where the device tests serve their indicator lists (FeedTest). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
